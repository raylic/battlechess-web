{
  "name": "battlechess-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "皇家战棋核心玩法的 Web 复刻（Vite + React + TS）",
  "scripts": {
    "dev": "NODE_ENV=development vite",
    "build": "NODE_ENV=production tsc -b && vite build",
    "preview": "vite preview",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "coverage": "NODE_ENV=test vitest run --coverage",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "assets": "bash scripts/fetch-assets.sh",
    "click:check": "node scripts/click-check.mjs",
    "pwa:check": "node scripts/pwa-check.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
